# Copy this file to .env and replace the development passwords.
MYSQL_DATABASE=portfolio
MYSQL_USER=portfolio_user
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_root_password

MYSQL_PORT=3306
BACKEND_PORT=8080

# Create a personal key at https://twelvedata.com and do not commit it.
TWELVE_DATA_API_KEY=replace_with_your_key
